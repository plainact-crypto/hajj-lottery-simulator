{
  "name": "hajj-lottery-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content:audit": "node scripts/content-audit.mjs",
    "qa": "node scripts/qa-audit.mjs",
    "build": "npm run content:audit && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr-dist && node scripts/prerender.mjs && npm run qa",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
